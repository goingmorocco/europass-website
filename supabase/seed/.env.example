# ── API Server ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host:5432/europass

# Port the API server listens on (default: 8080)
PORT=8080

# Allowed frontend origin(s) for CORS — comma-separated for multiple
# Leave empty in development to allow all origins
CORS_ORIGIN=https://your-frontend.pages.dev

# ── Frontend (Vite build-time variables, must be prefixed VITE_) ────────────────
# Base URL of the deployed API server (no trailing slash)
# Leave empty if frontend and API are served from the same origin
VITE_API_URL=https://your-api.railway.app

# ── Replit-only (do not set outside Replit) ────────────────────────────────────
# BASE_PATH=/europass   # Replit path-based routing prefix
# REPL_ID=...           # Set automatically by Replit — enables Replit plugins
